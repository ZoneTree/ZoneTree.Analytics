{
  "name": "zonetree-analytics-repo",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/ZoneTree.Analytics.Dashboard/ui",
    "docs-site"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "check-dependencies": "tsx scripts/check-dependencies.ts && yarn dedupe --check",
    "check:scripts": "tsc --project scripts/tsconfig.json",
    "check:workspaces": "yarn workspaces foreach --all --exclude zonetree-analytics-repo run check",
    "lint": "biome check . --formatter-enabled=false",
    "lint:fix": "biome check . --formatter-enabled=false --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "check": "yarn check-dependencies && yarn lint && yarn format:check && yarn check:scripts && yarn check:workspaces",
    "build:web": "yarn workspaces foreach --all --exclude zonetree-analytics-repo run build",
    "build": "dotnet build src/ZoneTree.Analytics.sln --configuration Release && yarn build:web",
    "test:web": "vitest run",
    "test:dotnet": "dotnet test src/ZoneTree.Analytics.sln --configuration Release",
    "test": "yarn test:web && yarn test:dotnet",
    "dashboard": "dotnet run --project apps/ZoneTree.Analytics.Dashboard/server --",
    "dashboard:dev": "yarn workspace zonetree-analytics-dashboard dev",
    "docs:dev": "yarn workspace analytics.zonetree.dev serve"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
