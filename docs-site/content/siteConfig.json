{
  "$schema": "https://raw.githubusercontent.com/PureStackStudio/PureStack/refs/heads/main/packages/ts-ssg/schema/siteConfig.schema.json",
  "siteTitle": "ZoneTree Analytics",
  "favicon": "iconoir:cube-hole",
  "style": {
    "fileName": "site.css",
    "href": "/assets/site.css",
    "themes": ["light", "dark"],
    "pretty": false,
    "theme": {
      "skin": "analytics"
    }
  },
  "auth": {
    "enabled": false,
    "signUp": false
  },
  "html": {
    "minify": true
  },
  "scripts": {
    "cacheBusting": true
  },
  "navigation": {
    "mode": "hybrid",
    "navFileName": "_nav.json",
    "maxDepth": 20,
    "includeIndex": true,
    "sortBy": "order",
    "roots": ["docs"]
  },
  "sitemap": {
    "enabled": true,
    "baseUrl": "https://analytics.zonetree.dev",
    "fileName": "sitemap.xml",
    "robots": {
      "enabled": true,
      "fileName": "robots.txt",
      "userAgent": "*",
      "allow": ["/"],
      "disallow": [],
      "crawlDelay": 2,
      "host": "analytics.zonetree.dev",
      "additionalSitemaps": [],
      "customDirectives": ["# Generated by PureStack"]
    }
  },
  "consent": {
    "enabled": true,
    "policyVersion": "2026-10-07",
    "privacyPolicyUrl": "/legal/privacy/",
    "categories": [
      {
        "id": "necessary",
        "label": "Necessary",
        "required": true
      }
    ],
    "services": []
  },
  "pagefind": {
    "enabled": true,
    "excludePaths": []
  },
  "preview": {
    "title": "ZoneTree Analytics",
    "description": "Analytics Engine for .NET. Collect events, query metrics, and host your own reporting dashboard.",
    "image": "/assets/landing-social-preview.png",
    "imageAlt": "ZoneTree Analytics landing page with the orange analytics engine illustration and 5M-event benchmark highlights",
    "imageWidth": 1200,
    "imageHeight": 630,
    "siteName": "ZoneTree Analytics",
    "twitterCard": "summary_large_image"
  },
  "logo": {
    "brand": "ZoneTree Analytics",
    "icon": "iconoir:cube-hole"
  },
  "mdx": {
    "highlighter": "shiki"
  },
  "outDir": "../dist/web-dev",
  "publishDir": "../dist/web"
}
