<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <LangVersion>13</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>ZoneTree.Analytics.AspNetCore</RootNamespace>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>ZoneTree.Analytics.AspNetCore</PackageId>
    <Title>ZoneTree.Analytics.AspNetCore</Title>
    <Description>ASP.NET Core integration for ZoneTree.Analytics: dependency injection, server-side page view tracking middleware, a cookie-less JavaScript tracker with a beacon endpoint, and a reporting API.</Description>
    <PackageTags>analytics;web-analytics;aspnetcore;middleware;privacy;tracker;reporting;zonetree</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\ZoneTree.Analytics\ZoneTree.Analytics.csproj" />
    <InternalsVisibleTo Include="ZoneTree.Analytics.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README-NUGET.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="tracker.js" LogicalName="ZoneTree.Analytics.AspNetCore.tracker.js" />
  </ItemGroup>

</Project>
