<Project>

  <!-- Shared by every project: the recommended .NET analyzers, with warnings as errors. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      The local ZoneTree checkout is a project reference outside this solution. Keep the
      configuration for such references, or Release builds would use a Debug ZoneTree.
    -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

</Project>
