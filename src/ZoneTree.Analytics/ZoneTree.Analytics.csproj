<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <LangVersion>13</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <NeutralLanguage>en-US</NeutralLanguage>
    <RepositoryUrl>https://github.com/ZoneTree/ZoneTree.Analytics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PackageId>ZoneTree.Analytics</PackageId>
    <RootNamespace>ZoneTree.Analytics</RootNamespace>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="docs/ZoneTree.Analytics/README-NUGET.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
    </None>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!--
    ZoneTree is the only dependency. During development it is referenced from a local checkout
    next to this repository (it needs ZoneTreeFactory.Validate, which is not published yet).
    Another checkout:      dotnet build -p:ZoneTreeProjectPath=path/to/ZoneTree.csproj
    The NuGet package:     dotnet build -p:UseZoneTreePackage=true
  -->
  <PropertyGroup Condition="'$(ZoneTreeProjectPath)' == '' and '$(UseZoneTreePackage)' != 'true'">
    <ZoneTreeProjectPath>$(MSBuildThisFileDirectory)..\..\..\ZoneTree\src\ZoneTree\ZoneTree.csproj</ZoneTreeProjectPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(ZoneTreeProjectPath)' == ''">
    <PackageReference Include="ZoneTree" Version="1.9.8" />
  </ItemGroup>
  <ItemGroup Condition="'$(ZoneTreeProjectPath)' != ''">
    <ProjectReference Include="$(ZoneTreeProjectPath)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZoneTree.Analytics.UnitTests" />
  </ItemGroup>

</Project>
