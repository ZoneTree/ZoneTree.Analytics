<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <LangVersion>13</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>ZoneTree.Analytics</RootNamespace>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>ZoneTree.Analytics</PackageId>
    <Title>ZoneTree.Analytics</Title>
    <Description>ZoneTree.Analytics is a lightweight, embeddable, high-performance analytics engine for .NET. It records web analytics, custom events, telemetry and business metrics, and answers time-series, breakdown and unique-visitor queries directly inside your application, using ZoneTree as its storage engine.</Description>
    <PackageTags>analytics;web-analytics;embedded-analytics;privacy;page-views;unique-visitors;sessions;events;telemetry;metrics;time-series;hyperloglog;zonetree;lsm-tree;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README-NUGET.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZoneTree" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZoneTree.Analytics.UnitTests" />
  </ItemGroup>

</Project>
