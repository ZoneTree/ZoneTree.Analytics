{
  "siteTitle": "ZoneTree Analytics",
  "favicon": "iconoir:cube-hole",
  "logo": {
    "brand": "ZoneTree Analytics",
    "icon": "iconoir:cube-hole",
    "href": "/",
    "markStyle": "solid",
    "size": "md",
    "brandColor": "#F8F8FA",
    "markBackground": "#DD9CF0",
    "markColor": "#2D1237"
  },
  "outDir": "../dist/site",
  "publishDir": "../dist/publish",
  "pageToc": { "enabled": false },
  "pagefind": { "enabled": false },
  "sitemap": { "enabled": false, "robots": { "enabled": false } },
  "auth": {
    "enabled": true,
    "signUp": false,
    "signedInStorageKey": "signed-in-hint"
  },
  "consent": { "enabled": false },
  "style": {
    "themes": ["light", "dark"],
    "theme": { "skin": "zonetree" },
    "href": "/assets/site.css"
  },
  "html": { "minify": true },
  "scripts": { "cacheBusting": true }
}
