<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ZoneTree.Analytics.UnitTests" />
  </ItemGroup>
  <!-- Local datasets are not build content: the Web SDK would copy their metadata JSON files. -->
  <ItemGroup>
    <Content Remove="data/**" />
    <None Remove="data/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PureGate.WebSocket" Version="1.0.0" />
    <ProjectReference Include="../../../src/ZoneTree.Analytics.AspNetCore/ZoneTree.Analytics.AspNetCore.csproj" />
  </ItemGroup>
</Project>
